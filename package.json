{
  "name": "airdrawing",
  "private": true,
  "version": "1.0.0",
  "description": "Ultra-lightweight Camera Air-Drawing Web Application powered by MediaPipe Tasks Vision, TypeScript, and HTML5 Canvas",
  "homepage": "https://airdrawing-mu.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElXprogramming/airdrawing.git"
  },
  "keywords": [
    "air-drawing",
    "mediapipe",
    "hand-tracking",
    "gesture-recognition",
    "html5-canvas",
    "one-euro-filter",
    "typescript",
    "vite",
    "computer-vision"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
